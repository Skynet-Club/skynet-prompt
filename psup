def cmd_verify(args) -> int:
    result = verify_content()
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        origins = result["origins"]
        parts = " / ".join(
            f"{ORIGIN_LABELS[name]} {origins[name]}" for name in ORIGIN_LABELS
        )
        print(f"内容 {result['count']} 条 · {parts} · 节选 {result['excerpts']}")
        print(f"digest {result['digest']}")
        if result["legacy"] == "match":
            print("与 data/prompts.json 逐字节一致")
        elif result["legacy"] == "absent":
            print("未找到 data/（跳过迁移比对）")
        else:
            print("与 data/prompts.json 不一致", file=sys.stderr)
        for error in result["errors"]:
            print("  ✗ " + error, file=sys.stderr)
    return 0 if result["ok"] else 1


def cmd_build(args) -> int:
    hosts = tuple(HOSTS) if args.host == "all" else (args.host,)
    if args.check:
        result = check_artifacts(hosts=hosts)
        if args.json:
            print(json.dumps(result, ensure_ascii=False, indent=2))
        elif result["ok"]:
            print(f"产物已是最新：{result['expected']} 个文件（{' + '.join(hosts)}）")
        else:
            print("产物与 content/ 不一致：", file=sys.stderr)
            for kind, label in (("missing", "缺少"), ("different", "已改"), ("extra", "多余")):
                for rel in result[kind]:
                    print(f"  {label} {rel}", file=sys.stderr)
        return 0 if result["ok"] else 1

    result = build_artifacts(hosts=hosts)
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    else:
        print(
            f"生成 {result['expected']} 个文件（{' + '.join(hosts)}）· "
            f"写入 {result['written']} · 删除 {len(result['removed'])}"
        )
        for rel in result["added"]:
            print("  + " + rel)
        for rel in result["changed"]:
            print("  ~ " + rel)
        for rel in result["removed"]:
            print("  - " + rel)
    return 0 if result["ok"] else 1


