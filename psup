            kind=args.kind,
            note=args.note,
        )
    except (PromptServiceError, FeedbackError) as exc:
        raise SystemExit(f"psup: {exc}") from exc
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 0


def cmd_feedback_summary(args) -> int:
    print(json.dumps(
        summarize_feedback(feedback_path()),
        ensure_ascii=False,
        indent=2,
    ))
    return 0


def cmd_suggest(args) -> int:
    rows = advisor_suggest(
        PromptService(catalog()).items(),
        " ".join(args.words),
        limit=args.limit,
    )
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
    else:
        for row in rows:
            print("\t".join((
                row["id"],
                f"{row['score']:.1f}",
                ",".join(row["reasons"]),
                row["zh"],
            )))
    return 0


def trust_path(args) -> Path:
    return Path(
        args.trust or REPO / "trust" / "keys.json"
    ).expanduser()


def cmd_trust(args) -> int:
    try:
        payload = load_trust(trust_path(args))
    except TrustError as exc:
        raise SystemExit(f"psup: {exc}") from exc
    print(json.dumps(payload, ensure_ascii=False, indent=2))
    return 0


def cmd_trust_add(args) -> int:
    try:
        row = add_key(
            trust_path(args),
            Path(args.public_key).expanduser(),
            key_id=args.key_id,
            publisher=args.publisher,
            status=args.status,
            expires_at=args.expires_at,
        )
    except TrustError as exc:
        raise SystemExit(f"psup: {exc}") from exc
    print(json.dumps({"ok": True, "key": row}, ensure_ascii=False, indent=2))
    return 0


def cmd_trust_revoke(args) -> int:
    try:
        row = revoke_key(trust_path(args), args.key_id)
    except TrustError as exc:
        raise SystemExit(f"psup: {exc}") from exc
    print(json.dumps({"ok": True, "key": row}, ensure_ascii=False, indent=2))
    return 0


def main(argv: list[str]) -> int:
    if argv and argv[0] == "install":
        return subprocess.call([sys.executable, str(REPO / "scripts" / "install.py"), *argv[1:]])
    known = {
        "list", "show", "print", "pick", "selftest", "packs", "audit",
        "capabilities", "categories", "reviews", "safety", "sources",
        "candidates", "submit", "release", "registry", "update", "rollback",
        "doctor", "cache", "pin", "unpin", "events", "team", "team-update",
        "approve", "feedback", "feedback-summary", "suggest",
        "trust", "trust-add", "trust-revoke", "verify", "build", "version",
    }
    if not argv:
        argv = ["pick"]          # 不带参数就是交互选择
    elif argv[0] not in known and not argv[0].startswith("-"):
        argv = ["list", *argv]   # psup 验收 → 直接过滤
    ap = argparse.ArgumentParser(
        prog="psup",
        description="提示词补充：命令行入口",
        epilog=(
            f"Agent 统一触发器：{CANONICAL_TRIGGER}。"
            "宿主集成安装：psup install [codex|pi|opencode|hermes|copilot|claude]"
        ),
    )
    ap.add_argument("--version", action="version", version=__version__)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p_version = sub.add_parser("version", help="输出产品版本")
    p_version.set_defaults(func=cmd_version)

    p_list = sub.add_parser("list", help="列出条目（给 fzf 或脚本用）")
    p_list.add_argument("words", nargs="*", help="关键词，全部命中才算")
    p_list.add_argument("--json", action="store_true")
    p_list.add_argument("--pack", help="只列指定提示词包")
    p_list.add_argument("--category", help="按类目键或显示名过滤")
    p_list.add_argument("--limit", type=int, help="最多返回多少条")
    p_list.set_defaults(func=cmd_list)

    p_show = sub.add_parser("show", help="显示一条的完整内容")
    p_show.add_argument("id")
    p_show.add_argument("--width", type=int, default=0)
    p_show.set_defaults(func=cmd_show)

    p_print = sub.add_parser("print", help="只输出某字段（默认中文）")
    p_print.add_argument("id")
    p_print.add_argument("--field", default="zh", choices=["zh", "en", "id", "url", "author"])
    p_print.add_argument("--lang", help="读取指定语言译文，例如 zh-CN")
    p_print.set_defaults(func=cmd_print)

    p_pick = sub.add_parser("pick", help="fzf 交互选择，选中后把正文打到 stdout")
    p_pick.add_argument("words", nargs="*")
    p_pick.add_argument("--field", default="zh", choices=["zh", "en", "id"])
    p_pick.set_defaults(func=cmd_pick)

    p_self = sub.add_parser("selftest", help="条数 + sha256 自检")
    p_self.set_defaults(func=cmd_selftest)

    p_packs = sub.add_parser("packs", help="列出已加载的提示词包")
    p_packs.add_argument("--json", action="store_true")
    p_packs.set_defaults(func=cmd_packs)

    p_audit = sub.add_parser("audit", help="审计结构化来源证据")
    p_audit.add_argument("--json", action="store_true")
    p_audit.set_defaults(func=cmd_audit)

    p_caps = sub.add_parser("capabilities", help="列出各入口与宿主支持等级")
    p_caps.add_argument("--json", action="store_true")
    p_caps.set_defaults(func=cmd_capabilities)

    p_categories = sub.add_parser("categories", help="列出提示词类目")
    p_categories.add_argument("--json", action="store_true")
    p_categories.set_defaults(func=cmd_categories)

    p_safety = sub.add_parser("safety", help="扫描提示词注入、凭据外传和危险命令")
    p_safety.add_argument("--json", action="store_true")
    p_safety.set_defaults(func=cmd_safety)

    p_reviews = sub.add_parser("reviews", help="校验来源与翻译审核账本")
    p_reviews.add_argument("--json", action="store_true")
    p_reviews.set_defaults(func=cmd_reviews)

    p_sources = sub.add_parser("sources", help="校验来源快照 manifest 与文件哈希")
    p_sources.add_argument("--json", action="store_true")
    p_sources.set_defaults(func=cmd_sources)

    p_candidates = sub.add_parser("candidates", help="列出候选提交")
    p_candidates.add_argument("--json", action="store_true")
    p_candidates.set_defaults(func=cmd_candidates)

    p_submit = sub.add_parser("submit", help="提交一条候选 JSON 并检查重复")
    p_submit.add_argument("file")
    p_submit.add_argument("--as", dest="as_name", default="unknown")
    p_submit.set_defaults(func=cmd_submit)

    p_release = sub.add_parser("release", help="执行完整 v2 发布流水线")
    p_release.add_argument("--out", default=str(REPO / "dist" / "release"))
    p_release.add_argument("--channel", choices=["dev", "canary", "stable"], default="dev")
    p_release.add_argument("--private-key")
    p_release.add_argument("--key-id", default="skynet-club-dev")
    p_release.add_argument("--approval", action="append", default=[])
    p_release.add_argument("--trust", default=str(REPO / "trust" / "keys.json"))
    p_release.set_defaults(func=cmd_release)

    p_approve = sub.add_parser("approve", help="为已生成 Pack 创建签名审批")
    p_approve.add_argument("--release", required=True)
    p_approve.add_argument("--as", dest="approver", required=True)
    p_approve.add_argument("--role", choices=["reviewer", "publisher"], required=True)
    p_approve.add_argument("--private-key", required=True)
    p_approve.add_argument("--key-id", required=True)
    p_approve.set_defaults(func=cmd_approve)

    p_registry = sub.add_parser("registry", help="校验 Registry manifest 并可选择包")
    p_registry.add_argument("manifest")
    p_registry.add_argument("--root")
    p_registry.add_argument("--trust", default=str(REPO / "trust" / "keys.json"))
    p_registry.add_argument("--pack")
    p_registry.add_argument("--channel", choices=["dev", "canary", "stable"], default="dev")
    p_registry.set_defaults(func=cmd_registry)

    p_update = sub.add_parser("update", help="从 Registry 增量安装 Pack")
    p_update.add_argument(
        "--registry",
        default=str(REPO / "dist" / "registry" / "registry.json"),
    )
    p_update.add_argument("--pack", default="official")
    p_update.add_argument("--channel", choices=["dev", "canary", "stable"], default="dev")
    p_update.add_argument("--store")
    p_update.add_argument("--trust", default=str(REPO / "trust" / "keys.json"))
    p_update.set_defaults(func=cmd_update)

    p_rollback = sub.add_parser("rollback", help="回滚到上一安装版本")
    p_rollback.add_argument("--pack", default="official")
    p_rollback.add_argument("--channel", choices=["dev", "canary", "stable"], default="dev")
    p_rollback.add_argument("--store")
    p_rollback.add_argument("--trust", default=str(REPO / "trust" / "keys.json"))
    p_rollback.set_defaults(func=cmd_rollback)

    p_doctor = sub.add_parser("doctor", help="检查本地 Pack、签名和 Registry 状态")
    p_doctor.add_argument("--registry")
    p_doctor.add_argument("--store")
    p_doctor.add_argument("--trust", default=str(REPO / "trust" / "keys.json"))
    p_doctor.set_defaults(func=cmd_doctor)

    p_cache = sub.add_parser("cache", help="检查内容寻址缓存")
    p_cache.add_argument("--store")
    p_cache.set_defaults(func=cmd_cache)

    p_pin = sub.add_parser("pin", help="固定当前或已安装版本")
    p_pin.add_argument("--pack", default="official")
    p_pin.add_argument("--channel", choices=["dev", "canary", "stable"], default="dev")
    p_pin.add_argument("--version")
    p_pin.add_argument("--store")
    p_pin.set_defaults(func=cmd_pin)

    p_unpin = sub.add_parser("unpin", help="解除版本固定")
    p_unpin.add_argument("--pack", default="official")
    p_unpin.add_argument("--channel", choices=["dev", "canary", "stable"], default="dev")
    p_unpin.add_argument("--store")
    p_unpin.set_defaults(func=cmd_unpin)

    p_events = sub.add_parser("events", help="读取本地更新与回滚事件")
    p_events.add_argument("--limit", type=int, default=100)
    p_events.add_argument("--store")
    p_events.set_defaults(func=cmd_events)

    p_team = sub.add_parser("team", help="校验团队 Registry 与角色配置")
    p_team.add_argument("--config")
    p_team.add_argument("--user")
    p_team.add_argument("--action", choices=["submit", "review", "publish", "admin", "read"])
    p_team.set_defaults(func=cmd_team)

    p_team_update = sub.add_parser("team-update", help="从团队指定 Registry 更新 Pack")
    p_team_update.add_argument("--config")
    p_team_update.add_argument("--registry-id", required=True)
    p_team_update.add_argument("--pack", default="official")
    p_team_update.add_argument("--store")
    p_team_update.set_defaults(func=cmd_team_update)

    p_feedback = sub.add_parser("feedback", help="记录本地提示词反馈")
    p_feedback.add_argument("id")
    p_feedback.add_argument(
        "--kind",
        choices=["adopted", "undone", "useful", "not-useful", "source-broken"],
        required=True,
    )
    p_feedback.add_argument("--note", default="")
    p_feedback.set_defaults(func=cmd_feedback)

    p_feedback_summary = sub.add_parser("feedback-summary", help="汇总本地反馈")
    p_feedback_summary.set_defaults(func=cmd_feedback_summary)

    p_suggest = sub.add_parser("suggest", help="可解释地建议候选，不修改正文")
    p_suggest.add_argument("words", nargs="*")
    p_suggest.add_argument("--limit", type=int, default=5)
    p_suggest.add_argument("--json", action="store_true")
    p_suggest.set_defaults(func=cmd_suggest)

    p_trust = sub.add_parser("trust", help="列出发布者公钥信任库")
    p_trust.add_argument("--trust")
    p_trust.set_defaults(func=cmd_trust)

    p_trust_add = sub.add_parser("trust-add", help="登记第三方 Ed25519 公钥")
    p_trust_add.add_argument("--trust")
    p_trust_add.add_argument("--public-key", required=True)
    p_trust_add.add_argument("--key-id", required=True)
    p_trust_add.add_argument("--publisher", required=True)
    p_trust_add.add_argument("--status", choices=["active", "dev"], default="active")
    p_trust_add.add_argument("--expires-at")
    p_trust_add.set_defaults(func=cmd_trust_add)

    p_trust_revoke = sub.add_parser("trust-revoke", help="撤销发布者公钥")
    p_trust_revoke.add_argument("--trust")
    p_trust_revoke.add_argument("--key-id", required=True)
    p_trust_revoke.set_defaults(func=cmd_trust_revoke)

    p_verify = sub.add_parser("verify", help="校验 content/ 并比对 data/ 迁移结果")
    p_verify.add_argument("--json", action="store_true")
    p_verify.set_defaults(func=cmd_verify)

    p_build = sub.add_parser("build", help="从 content/ 生成宿主产物")
    p_build.add_argument("--host", default="all", choices=["all", "pi", "codex", "opencode"])
    p_build.add_argument("--check", action="store_true", help="只比对，不写文件")
    p_build.add_argument("--json", action="store_true")
    p_build.set_defaults(func=cmd_build)

    args = ap.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
