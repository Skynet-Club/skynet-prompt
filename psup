def catalog() -> PromptCatalog:
    try:
        return default_catalog().load()
    except PromptDataError as exc:
        raise SystemExit(f"psup: {exc}") from exc


def load() -> tuple[list[dict], dict]:
    service = PromptService(catalog())
    return service.items(), {"packs": service.packs()}


def oneline(item: dict, width: int = 24) -> str:
    """fzf 的一行：id 在第一位（预览占位符用），显示列是截断后的中文 + 作者 + 类目。

    正文不截断的话，fzf 搜索命中在长句尾部时会横向滚到句尾，列表看起来像从中间开始。
    """
    author = item.get("author", "")
    text = " ".join(item["zh"].split())
    if len(text) > width:
        text = text[: width - 1] + "…"
    return "\t".join((item["id"], DISPLAY.get(item.get("cat", ""), ""), text, author))


def wide(text: str, width: int) -> list[str]:
    """按终端显示宽度折行（中文两格）。不依赖 prompt_toolkit。"""
    import unicodedata

    def w(ch: str) -> int:
        return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1

    lines, cur, cur_w = [], "", 0
    for ch in " ".join(text.split()):
        cw = w(ch)
        if cur_w + cw > width:
            cut = cur.rfind(" ")
            if cut > len(cur) // 2:
                lines.append(cur[:cut])
                cur = cur[cut + 1 :]
                cur_w = sum(w(c) for c in cur)
            elif ch in "。，、；：？！）】」』”’…":
                keep = cur[-1] if cur else ""
                lines.append(cur[:-1])
                cur = keep
                cur_w = sum(w(c) for c in cur)
            else:
                lines.append(cur)
                cur, cur_w = "", 0
        cur += ch
        cur_w += cw
    if cur:
        lines.append(cur)
    return lines or [""]


def show_block(item: dict, width: int = 56) -> str:
    out = [f"{DISPLAY.get(item.get('cat', ''), '')}"]
    out.append(f"{item.get('author', '')} · {item.get('date', '')} · {item.get('nature', '未核实')}")
    out.append("─" * min(width, 56))
    out.append("原文（节选，全文见链接）" if item.get("excerpt") else "原文")
    out += ["  " + ln for ln in wide(item.get("en", ""), width)]
    out.append("")
    out.append("中文")
    out += ["  " + ln for ln in wide(item.get("zh", ""), width)]
    out.append("")
    out += wide(item.get("url", ""), width)
    return "\n".join(out)


def cmd_list(args) -> int:
    service = PromptService(catalog())
    try:
        rows = service.search(
            " ".join(args.words),
            category=args.category,
            pack=args.pack,
            limit=args.limit,
        )
    except PromptServiceError as exc:
        raise SystemExit(f"psup: {exc}") from exc
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
        return 0
    for item in rows:
        print(oneline(item))
    return 0


