def cmd_approve(args) -> int:
    try:
        approval = create_approval(
            Path(args.release).expanduser(),
            approver=args.approver,
            role=args.role,
            private_key=Path(args.private_key).expanduser(),
            key_id=args.key_id,
        )
    except ApprovalError as exc:
        raise SystemExit(f"psup: {exc}") from exc
    out = Path(args.release).expanduser() / "approvals" / f"{approval['approval_id']}.json"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(approval, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(json.dumps({
        "ok": True,
        "out": str(out),
        "approval_id": approval["approval_id"],
        "approver": approval["approver"],
        "role": approval["role"],
    }, ensure_ascii=False, indent=2))
    return 0


def cmd_registry(args) -> int:
    manifest = Path(args.manifest).expanduser()
    root = Path(args.root).expanduser() if args.root else manifest.parent
    trust = Path(args.trust).expanduser()
    try:
        registry = load_registry(manifest)
        result = verify_registry(root, registry, trust_path=trust)
        selected = (
            select_pack(registry, args.pack, args.channel)
            if args.pack
            else None
        )
    except RegistryError as exc:
        raise SystemExit(f"psup: {exc}") from exc
    output = {**result, "selected": selected}
    print(json.dumps(output, ensure_ascii=False, indent=2))
    return 0 if result["ok"] else 1


