def cmd_submit(args) -> int:
    path = Path(args.file)
    try:
        candidate = json.loads(path.read_text(encoding="utf-8"))
        store = load_store(candidates_path())
        result = add_candidate(store, candidate, submitted_by=args.as_name)
        if result["added"]:
            save_store(candidates_path(), store)
    except (OSError, json.JSONDecodeError, CandidateError) as exc:
        raise SystemExit(f"psup: {exc}") from exc
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 0 if result["added"] else 1


