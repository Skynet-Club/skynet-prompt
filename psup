def cmd_print(args) -> int:
    try:
        item = PromptService(catalog()).get(args.id)
    except PromptServiceError as exc:
        raise SystemExit(f"psup: {exc}") from exc
    if args.lang:
        if args.lang in {"zh", "zh-CN", "zh-cn"}:
            print(item["zh"])
            return 0
        translation = next(
            (
                row for row in item.get("translations", [])
                if row.get("language", "").casefold() == args.lang.casefold()
            ),
            None,
        )
        if translation is None:
            raise SystemExit(f"psup: {args.id} 没有 {args.lang} 译文")
        print(translation["text"])
        return 0
    field = args.field
    print(item.get(field, ""))
    return 0


def cmd_selftest(args) -> int:
    loaded = catalog()
    items = loaded.items()
    packs = loaded.packs()
    builtin = next((pack for pack in packs if pack.id == "builtin"), packs[0])
    meta = builtin.meta
    digest = builtin.sha256
    counts = {key: sum(1 for i in items if i.get("cat") == key) for _, key in CATS}
    result = {
        "ok": len(items) == meta.get("count", len(items)),
        "count": len(items),
        "cats": sum(1 for v in counts.values() if v),
        "schema_version": meta.get("schema_version", 1),
        "natures": meta.get("natures", {}),
        "excerpts": meta.get("excerpts", 0),
        "sha256": digest,
        "meta_sha256": meta.get("sha256"),
        "data": str(builtin.path),
        "pack_count": len(packs),
        "packs": [
            {"id": pack.id, "name": pack.name, "version": pack.version, "count": len(pack.items)}
            for pack in packs
        ],
    }
    result["ok"] = bool(result["ok"] and digest == meta.get("sha256", digest))
    print(json.dumps(result, ensure_ascii=False))
    return 0 if result["ok"] else 1


def cmd_pick(args) -> int:
    service = PromptService(catalog())
    try:
        rows = service.search(" ".join(args.words))
    except PromptServiceError as exc:
        raise SystemExit(f"psup: {exc}") from exc
    if not rows:
        raise SystemExit("psup: 没有匹配的条目")
    if not shutil.which("fzf"):
        raise SystemExit("psup: 没装 fzf（apt install fzf / brew install fzf）")
    self_path = shutil.which("psup") or str(Path(__file__).resolve())
    feed = "\n".join(oneline(i) for i in rows)
    cmd = [
        "fzf",
        "--delimiter=\t",
        "--with-nth=2,3,4",   # 显示 类目/中文/作者；搜索也搜这三列 + id
        "--no-hscroll",        # 命中在句尾时不要横向滚走句首
        "--height=80%",
        "--ansi",
        "--prompt=提示词补充> ",
        "--header=↑↓ 选 · 回车补到 stdout · 输入关键词过滤 · Esc 取消",
        f"--preview={self_path} show {{1}}",
        "--preview-window=right:48%:wrap",
    ]
    proc = subprocess.run(cmd, input=feed, text=True, capture_output=True)
    if proc.returncode != 0:
        return 130
    line = proc.stdout.rstrip("\n")
    if not line:
        return 130
    rid = line.split("\t")[0]
    found = [i for i in service.items() if i["id"] == rid]
    if not found:
        raise SystemExit(f"psup: 选中的 id={rid} 不存在")
    print(found[0].get(args.field, ""))
    return 0


