#!/usr/bin/env python3
"""skynet-prompt 命令行：给人和 Agent 的稳定只读入口。"""

from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path

if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
if hasattr(sys.stderr, "reconfigure"):
    sys.stderr.reconfigure(encoding="utf-8", errors="replace")

REPO = Path(__file__).resolve().parent
sys.path.insert(0, str(REPO))

from skynet_prompt import __version__  # noqa: E402
from skynet_prompt.catalog import (  # noqa: E402
    DISPLAY,
    PromptDataError,
    default_catalog,
)


def catalog():
    return default_catalog().load()


def _clip(text: str, width: int = 42) -> str:
    text = " ".join(str(text).split())
    return text if len(text) <= width else text[: width - 1] + "…"


def _json(payload) -> None:
    print(json.dumps(payload, ensure_ascii=False))


def cmd_list(args) -> int:
    rows = catalog().search(" ".join(args.query), category=args.category, limit=args.limit)
    if args.json:
        _json(rows)
        return 0
    for item in rows:
        print(f"{item['id']}\t{DISPLAY[item['cat']]}\t{_clip(item['zh'])}\t{item['author']}")
    return 0


def cmd_show(args) -> int:
    item = catalog().get(args.id)
    if args.json:
        _json(item)
        return 0
    print(f"id       {item['id']}")
    print(f"场景     {DISPLAY[item['cat']]}")
    print(f"作者     {item['author']}")
    print(f"日期     {item['date']}")
    print(f"性质     {item.get('nature', '未标注')}")
    verdict = (item.get("evidence") or {}).get("verdict", "unverified")
    print(f"证据     { {'verbatim': '逐字可核', 'paraphrase': '他人整理', 'unverified': '未核实'}.get(verdict, verdict) }")
    print(f"链接     {item['url']}")
    print()
    print(item["zh"])
    if item.get("en"):
        print()
        print(item["en"])
    return 0


def cmd_print(args) -> int:
    item = catalog().get(args.id)
    value = item.get(args.field, "")
    print(value)
    return 0


def cmd_categories(args) -> int:
    rows = catalog().categories()
    if args.json:
        _json(rows)
        return 0
    for row in rows:
        print(f"{row['key']}\t{row['name']}\t{row['count']}")
    return 0


def cmd_packs(args) -> int:
    rows = catalog().packs()
    if args.json:
        _json(rows)
        return 0
    for row in rows:
        print(f"{row['id']}\t{row['name']}\t{row['version']}\t{row['count']}\t官方 {row['official_count']}")
    return 0


def cmd_selftest(_args) -> int:
    c = catalog()
    categories = c.categories()
    items = c.items()
    natures: dict[str, int] = {}
    for item in items:
        name = item.get("nature", "未标注")
        natures[name] = natures.get(name, 0) + 1
    meta = c.meta()
    result = {
        "ok": bool(
            items
            and len(items) == meta.get("count")
            and c.sha256 == meta.get("sha256")
        ),
        "count": len(items),
        "cats": len(categories),
        "official_count": sum(
            1 for item in items
            if (item.get("evidence") or {}).get("verdict") == "verbatim"
        ),
        "natures": natures,
        "excerpts": sum(1 for item in items if item.get("excerpt")),
        "sha256": c.sha256,
        "meta_sha256": meta.get("sha256"),
        "version": meta.get("version"),
        "data": str(c.path),
        "pack_count": 1,
        "packs": c.packs(),
    }
    _json(result)
    return 0 if result["ok"] else 1


def cmd_audit(args) -> int:
    result = catalog().audit()
    if args.json:
        _json(result)
    else:
        evidence = result["evidence"]
        print(
            f"证据 {result['count']} 条：verbatim {evidence['verbatim']} · "
            f"paraphrase {evidence['paraphrase']} · unverified {evidence['unverified']}"
        )
        print("版权：" + " · ".join(f"{k} {v}" for k, v in result["rights"].items()))
        label = f"可发布（{result['official_count']} 条 verbatim）" if result["official_ready"] else "含未核实条目"
        print("正式包：" + label)
        for item_id in result["missing"]:
            print(f"缺少结构化证据：{item_id}")
        for item_id in result["missing_rights"]:
            print(f"缺少版权字段：{item_id}")
    return 0 if result["ok"] else 1


def cmd_doctor(_args) -> int:
    try:
        c = catalog()
        categories = c.categories()
        result = {
            "ok": True,
            "version": __version__,
            "data": str(c.path),
            "count": len(c.items()),
            "categories": len(categories),
            "sha256": c.sha256,
            "packs": c.packs(),
        }
    except PromptDataError as exc:
        result = {"ok": False, "version": __version__, "error": str(exc)}
    _json(result)
    return 0 if result["ok"] else 1


def cmd_admin(args) -> int:
    from skynet_prompt.admin import AdminError, run_admin
    try:
        run_admin(port=args.port, open_browser=not args.no_open)
    except (AdminError, OSError) as exc:
        print(f"psup admin: {exc}", file=sys.stderr)
        return 1
    return 0


def cmd_pick(args) -> int:
    if shutil.which("fzf") is None:
        print("psup: 没有找到 fzf；用 psup list / psup print <id> 代替", file=sys.stderr)
        return 1
    rows = catalog().items()
    feed = "\n".join(
        f"{item['id']}\t{DISPLAY[item['cat']]}\t{_clip(item['zh'], 60)}\t{item['author']}"
        for item in rows
    )
    proc = subprocess.run(
        ["fzf", "--delimiter=\t", "--with-nth=2,3,4", "--prompt=psup> "],
        input=feed, text=True, capture_output=True,
    )
    if proc.returncode != 0 or not proc.stdout.strip():
        return 130
    item_id = proc.stdout.split("\t", 1)[0]
    try:
        item = catalog().get(item_id)
    except PromptDataError:
        return 1
    print(item.get(args.field, ""))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="psup")
    parser.add_argument("--version", action="version", version=__version__)
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("list", help="列出/搜索提示词")
    p.add_argument("query", nargs="*")
    p.add_argument("--category")
    p.add_argument("--limit", type=int)
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("show", help="显示一条的全文")
    p.add_argument("id")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("print", help="只输出一条的某个字段")
    p.add_argument("id")
    p.add_argument("--field", default="zh",
                   choices=("id", "cat", "author", "date", "url", "en", "zh"))
    p.set_defaults(func=cmd_print)

    p = sub.add_parser("categories", help="列出场景与条数")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_categories)

    p = sub.add_parser("packs", help="列出提示词包")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_packs)

    p = sub.add_parser("selftest", help="校验条数、场景和 sha256")
    p.set_defaults(func=cmd_selftest)

    p = sub.add_parser("audit", help="汇总证据与版权")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_audit)

    p = sub.add_parser("doctor", help="检查本地数据是否可用")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("admin", help="启动本地提示词库管理后台")
    p.add_argument("--port", type=int, default=8788)
    p.add_argument("--no-open", action="store_true")
    p.set_defaults(func=cmd_admin)

    p = sub.add_parser("pick", help="fzf 选择一条")
    p.add_argument("--field", default="zh",
                   choices=("id", "cat", "author", "date", "url", "en", "zh"))
    p.set_defaults(func=cmd_pick)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "command", None):
        args = parser.parse_args(["pick"])
    try:
        return args.func(args)
    except PromptDataError as exc:
        print(f"psup: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
